# ==============================================================================
# 民泊管理用 在室・入退室検知システム 環境設定テンプレート (.env.example)
#
# このファイルをコピーして `.env` という名前のファイルを同じディレクトリに作成し、
# 実際の環境に合わせて値を書き換えてください。
# (.env はGit管理から除外されているため、GitHubに公開されません)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Tapo C200 防犯カメラの設定
# ------------------------------------------------------------------------------
# Tapoアプリの「デバイス設定」->「高度な設定」->「カメラのアカウント」で作成したユーザー名とパスワード
TAPO_USER=admin
TAPO_PASS=your_tapo_password_here

# カメラのローカルIPアドレス (ルーターの管理画面等で固定IPに設定することを強く推奨します)
TAPO_IP=192.168.10.13
TAPO_PORT=554

# 配信ストリームの種類 (stream1: 1080pの高画質, stream2: 360pの低画質/低負荷)
TAPO_STREAM=stream1

# ------------------------------------------------------------------------------
# 2. スタッフ検知（清掃ノイズの除外）の設定
# ------------------------------------------------------------------------------
# スタッフのスマートフォンのWi-FiのMACアドレス
# ルーターの固定IP設定が面倒な場合に役立ちます。PCがネットワークをスキャンして検知します。
# 複数ある場合はカンマ区切りで指定可能です (大文字小文字は問いません)。
# (例: aa:bb:cc:dd:ee:ff,11:22:33:44:55:66)
STAFF_MACS=aa:bb:cc:dd:ee:ff

# ------------------------------------------------------------------------------
# 3. VPS（クラウドサーバー）連携設定
# ------------------------------------------------------------------------------
# 在室状況が変わった際（イベント発生時）にデータを送信するVPSのAPIエンドポイント
# 設定しない場合（空欄の場合）は、ローカルでのログ保存(CSV)のみを行います。
VPS_API_URL=https://your-vps-domain.com/api/occupancy
